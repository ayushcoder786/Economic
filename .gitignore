# ==============================================================================
# .gitignore - Comprehensive Exclusion Rules for Economic Data Pipeline
# ==============================================================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Environment variables, credentials, and secrets
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
secrets.json
credentials.json
token.json
client_secrets.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# R environment artifacts
.Rhistory
.RData
.Ruserdata
.Rproj.user/
Rplots.pdf
downloaded_packages/
Rtmp*/

# Large temporary files and editor caches
scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log
*.tar
*.gz
*.zip
*.7z

# Operating System specific files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
